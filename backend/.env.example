# Database — use SQLite locally when Postgres is unavailable.
# For local Postgres: postgresql+asyncpg://stagcore:stagcore@localhost:5432/stagcore
# For Neon: postgresql+asyncpg://user:pass@ep-xxx-pooler.neon.tech/db?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./stagcore.db
# Direct/unpooled URL for Alembic (same as DATABASE_URL when using SQLite)
DATABASE_URL_UNPOOLED=sqlite+aiosqlite:///./stagcore.db

# Auth — validated against shared DB session table
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret-minimum-length
BETTER_AUTH_URL=http://localhost:3000

# Platform admin — comma-separated emails that can toggle features
PLATFORM_ADMIN_EMAILS=admin@stagcore.local

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
